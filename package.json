{
  "name": "hades-orchestrator",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node subagent-bridge/src/server.js",
    "pilot": "node scripts/pilot-mcp.js",
    "pilot:flash": "node scripts/pilot-mcp.js --model deepseek_flash",
    "pilot:edit:deepseek": "node scripts/pilot-deepseek-edit.js",
    "accept:edit:deepseek": "node scripts/accept-deepseek-edit.js",
    "p0:e2e": "node scripts/p0-portability-e2e.js",
    "codex:configure": "node scripts/configure-codex-project.js --write",
    "codex:check": "node scripts/configure-codex-project.js --check",
    "codex:diagnose": "node scripts/codex-diagnostics.js",
    "canary:parallel": "node scripts/canary-parallel-routes.js",
    "canary:parallel:codex-ref": "node scripts/canary-parallel-codex-ref.js",
    "canary:parallel:codex-remote": "node scripts/canary-parallel-codex-remote-write.js",
    "parallel:watch": "node scripts/watch-parallel-batch.js",
    "smoke": "node scripts/smoke-mcp.js",
    "smoke:vault": "node scripts/smoke-mcp.js --real-vault --confirm-real-vault-read",
    "review:diagnose": "node scripts/diagnose-review-source.js",
    "metrics": "node scripts/report-metrics.js",
    "budget": "node scripts/report-metrics.js --budget-only",
    "replay": "node scripts/replay-run.js",
    "runs:recent": "node scripts/report-recent-runs.js",
    "runs:mirror": "node scripts/manage-project-logs.js",
    "edit:feedback": "node scripts/record-edit-feedback.js",
    "edit:classify": "node scripts/classify-edit-feedback.js",
    "routing:feedback": "node scripts/record-routing-feedback.js",
    "routing:classify": "node scripts/classify-routing-feedback.js",
    "hook:feedback": "node scripts/record-memory-hook-feedback.js",
    "hook:classify": "node scripts/classify-memory-hook.js",
    "hook:attribute-history": "node scripts/attribute-memory-hook-history.js",
    "memory:review": "node scripts/review-memory.js",
    "memory:doctor": "node scripts/doctor-memory.js",
    "memory:repair": "node scripts/repair-memory.js",
    "state:migrate": "node scripts/migrate-runtime-state.js",
    "hook:install": "node scripts/install-memory-hook.js",
    "memory:evaluate": "node scripts/evaluate-memory.js",
    "model-fit:evaluate": "node scripts/evaluate-model-fit.js",
    "model-fit:live": "node scripts/evaluate-model-fit.js --live config/model-fit-live-evaluation.json",
    "memory:prune-audit": "node scripts/prune-memory-audit.js",
    "skills:sync": "node scripts/sync-skills.js",
    "skills:check-global": "node scripts/check-global-skills.js",
    "test": "node --test --test-timeout=120000 tests/*.test.js && node --test --test-timeout=35000 tests/performance/memory-search.test.js",
    "verify:local": "node scripts/verify-local.js",
    "drill": "node --test --test-timeout=120000 tests/provider-failure-drill.test.js",
    "verify": "node scripts/verify-project.js",
    "verify:ci": "node scripts/verify-project-ci.js",
    "metrics:prune": "node scripts/report-metrics.js --prune",
    "config:backup": "node scripts/manage-config.js backup",
    "config:rollback": "node scripts/manage-config.js rollback",
    "config:apply-routing": "node scripts/apply-provider-routing.js",
    "config:apply-agent-modes": "node scripts/apply-agent-modes.js",
    "config:rollback-agent-modes": "node scripts/apply-agent-modes.js rollback",
    "video:collect": "node scripts/collect-video-transcript.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "fs-native-extensions": "1.5.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
